<Window x:Class="WuqueProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pocket Wuque" Height="900" Width="1120" MinHeight="760" MinWidth="850">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="180" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="Pocket Wuque dial app" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Margin="0,4,0,8" Foreground="DimGray" TextWrapping="Wrap"
                 Text="Select a keyboard, prepare a 320×172 dial image, then explicitly start a transfer. Device ACKs determine the final result." />
      <WrapPanel>
        <Button x:Name="ScanButton" Content="Scan" Click="Scan_Click" />
        <Button x:Name="StopButton" Content="Stop scan" Click="Stop_Click" IsEnabled="False" />
        <Button x:Name="ConnectButton" Content="Connect selected" Click="Connect_Click" IsEnabled="False" />
        <Button x:Name="DisconnectButton" Content="Disconnect" Click="Disconnect_Click" IsEnabled="False" />
        <Button x:Name="QueryButton" Content="Query version" Click="Query_Click" IsEnabled="False" />
        <Button x:Name="ChooseImageButton" Content="Choose image or GIF…" Click="ChooseImage_Click" />
        <Button x:Name="FirstPacketButton" Content="Transfer dial" Click="FirstPacket_Click" IsEnabled="False" />
        <Button Content="Clear log" Click="Clear_Click" />
        <Button Content="Export support bundle" Click="Export_Click" />
      </WrapPanel>
      <TextBlock x:Name="ImagePathText" Margin="4,2,4,4" Foreground="DimGray" Text="No image selected" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="StatusText" Margin="4,2,4,8" Text="Ready" />
      <ProgressBar x:Name="TransferProgressBar" Height="18" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
      <TextBlock x:Name="TransferProgressText" Margin="4,3,4,0" Foreground="DimGray" Visibility="Collapsed" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Drag the frame to reposition; drag its lower-right handle to scale the crop." Margin="2,0,0,6" />
        <Border BorderBrush="#808080" BorderThickness="1" Background="#202020" HorizontalAlignment="Left">
          <Canvas x:Name="CropCanvas" Width="640" Height="258" ClipToBounds="True"
                  MouseLeftButtonDown="CropCanvas_MouseLeftButtonDown" MouseMove="CropCanvas_MouseMove"
                  MouseLeftButtonUp="CropCanvas_MouseLeftButtonUp">
            <Image x:Name="SourceImage" Stretch="Uniform" Width="640" Height="258" />
            <Rectangle x:Name="CropFrame" Stroke="#FFFFC107" StrokeThickness="3" Fill="#30FFFFFF" Visibility="Collapsed" />
            <Ellipse x:Name="CropResizeHandle" Width="18" Height="18" Fill="#FFFFC107" Stroke="White" StrokeThickness="2"
                     Cursor="SizeNWSE" Visibility="Collapsed" />
          </Canvas>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="14,0,0,0">
        <TextBlock Text="Exact dial preview (320×172)" FontWeight="SemiBold" Margin="0,0,0,6" />
        <Border BorderBrush="#808080" BorderThickness="1" HorizontalAlignment="Left">
          <Image x:Name="FinalPreview" Width="320" Height="172" Stretch="Fill" />
        </Border>
        <TextBlock x:Name="CropInfoText" Margin="0,6,0,0" Foreground="DimGray" TextWrapping="Wrap" />
        <StackPanel Margin="0,6,0,0">
          <TextBlock Text="Layout" FontWeight="SemiBold" />
          <ComboBox x:Name="ImageLayoutCombo" Margin="0,3,0,0">
            <ComboBoxItem Content="Crop to fill (may cut edges)" />
            <ComboBoxItem Content="Fit entire image/GIF" />
          </ComboBox>
          <StackPanel x:Name="FitScalePanel" Margin="0,4,0,0" Orientation="Horizontal" Visibility="Collapsed">
            <TextBlock Text="Size" Width="42" VerticalAlignment="Center" />
            <Slider x:Name="FitScaleSlider" Width="180" Minimum="25" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" />
            <TextBlock x:Name="FitScaleText" Margin="6,0,0,0" Width="44" VerticalAlignment="Center" Text="100%" />
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="GifSpeedPanel" Margin="0,8,0,0" Visibility="Collapsed">
          <TextBlock x:Name="GifInfoText" TextWrapping="Wrap" />
          <DockPanel Margin="0,4,0,0">
            <TextBlock x:Name="GifSpeedText" DockPanel.Dock="Left" Width="100" VerticalAlignment="Center" />
            <Slider x:Name="GifSpeedSlider" Minimum="1" Maximum="10" Value="5" TickFrequency="1"
                    IsSnapToTickEnabled="True" ValueChanged="GifSpeedSlider_ValueChanged" />
          </DockPanel>
        </StackPanel>
      </StackPanel>
    </Grid>
    <DataGrid x:Name="DevicesGrid" Grid.Row="2" Margin="0,16,0,0" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionMode="Single" SelectionChanged="DevicesGrid_SelectionChanged" CanUserAddRows="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*" />
        <DataGridTextColumn Header="RSSI" Binding="{Binding Rssi}" Width="65" />
        <DataGridTextColumn Header="Service UUIDs" Binding="{Binding ServiceUuidsText}" Width="2*" />
        <DataGridTextColumn Header="Manufacturer data" Binding="{Binding ManufacturerDataText}" Width="2*" />
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="3" Margin="4,10,4,5" FontWeight="SemiBold"
               Text="Event log (raw notification values and OS write results are recorded separately)" />
    <TextBox x:Name="LogBox" Grid.Row="4" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
  </Grid>
</Window>
